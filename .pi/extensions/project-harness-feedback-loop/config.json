{
  "schemaVersion": 1,
  "name": "Project Harness Feedback Loop",
  "projectId": "chess-analysis-coach",
  "projectMarker": {
    "path": "pyproject.toml",
    "contains": "name = \"chess-analysis-coach\""
  },
  "requireCleanWorktree": true,
  "requirementFiles": [
    "AGENTS.md",
    "docs/requirements.md",
    "docs/architecture.md",
    "docs/testing.md"
  ],
  "checks": [
    {
      "name": "python-tests",
      "program": ".venv/Scripts/python.exe",
      "args": ["-m", "pytest"],
      "timeoutSeconds": 120
    },
    {
      "name": "harness-controller-tests",
      "program": "node",
      "args": ["--test", ".pi/extensions/project-harness-feedback-loop/core.test.mjs"],
      "timeoutSeconds": 30
    }
  ],
  "audit": {
    "thinkingLevel": "medium",
    "timeoutSeconds": 180,
    "interfaceChanges": "proposal-only"
  },
  "limits": {
    "maxDiffBytes": 200000,
    "maxCommandOutputBytes": 50000,
    "maxUntrackedFileBytes": 100000
  }
}
