{
  "schemaVersion": 1,
  "name": "Project Harness Feedback Loop",
  "projectId": "chess-analysis-coach",
  "projectMarker": {
    "path": "pyproject.toml",
    "contains": "name = \"chess-analysis-coach\""
  },
  "requireCleanWorktree": true,
  "requirementFiles": [
    "AGENTS.md",
    "docs/architecture.md",
    "docs/testing.md"
  ],
  "audit": {
    "thinkingLevel": "medium",
    "timeoutSeconds": 180,
    "interfaceChanges": "proposal-only"
  },
  "limits": {
    "maxDiffBytes": 150000,
    "maxUntrackedFileBytes": 75000
  }
}
